{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "version": "1.0.0",
  "description": "将日常 Chrome / Edge 浏览器的实时标签页与调试能力直接桥接到 Antigravity AI（无需新开浏览器）。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "debugger",
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
